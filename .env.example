# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://vu241fa04a72_db_user:sandeep123@cluster0.pck3mtl.mongodb.net/?appName=Cluster0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=iamsuperman

# ── App ───────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Public-facing URL — used to build the verify-email link sent in emails.
# In production replace with your real domain: https://myapp.com
BASE_URL=http://localhost:5000

# ── Flask-Mail (Phase 1) ──────────────────────────────────────────────────────
# Gmail example — generate an App Password at:
#   https://myaccount.google.com/apppasswords
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=vu.241fa04a72@gmail.com
MAIL_PASSWORD=sandeep123
MAIL_DEFAULT_SENDER=vu.241fa04a72@gmail.com

# ── Password Reset (Phase 2) ──────────────────────────────────────────────────
# No new env vars needed — password reset reuses JWT_SECRET (with a separate
# salt) and the same Flask-Mail SMTP settings configured above.
# Reset tokens expire after 30 minutes.

# ── File Uploads (Phase 4) ────────────────────────────────────────────────────
# Directory where uploaded files are stored (relative to project root).
# Use an absolute path in production, e.g. /var/data/uploads
UPLOAD_FOLDER=uploads/

# Maximum allowed upload size in bytes.
# Default shown below = 10 MB. Adjust as needed.
MAX_CONTENT_LENGTH=10485760

